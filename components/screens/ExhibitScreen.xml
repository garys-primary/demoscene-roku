<?xml version="1.0" encoding="utf-8" ?>
<component name="ExhibitScreen" extends="Group">
    <interface>
        <field id="exhibitIndex" type="integer" value="0" />
        <field id="origin" type="string" value="playAll" />
        <field id="autoplay" type="boolean" value="true" />
        <field id="catalog" type="assocarray" onChange="onCatalogChanged" />
        <field id="control" type="string" alwaysNotify="true" onChange="onControlChanged" />
        <field id="navEvent" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/brs/utils/catalogUtils.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/ExhibitScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />

        <Label id="workNumber" translation="[170, 100]" width="360" height="90" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="72" />
        </Label>
        <Label id="workYear" translation="[174, 190]" width="400" height="46" color="0x888888FF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="28" />
        </Label>

        <Label
            id="countLabel"
            translation="[1420, 96]"
            width="340"
            height="130"
            horizAlign="center"
            color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="96" />
        </Label>
        <Label
            id="countCaption"
            translation="[1420, 228]"
            width="340"
            height="40"
            horizAlign="center"
            color="0x888888FF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="22" />
        </Label>

        <Label id="workTitle" translation="[165, 280]" width="1560" height="140" wrap="true" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="52" />
        </Label>
        <Label id="workMeta" translation="[170, 430]" width="1500" height="46" color="0xA0A0A0FF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="26" />
        </Label>
        <Label
            id="workDescription"
            translation="[170, 496]"
            width="1560"
            height="220"
            wrap="true"
            color="0xC8C8C8FF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="26" />
        </Label>

        <Rectangle id="focusBar" translation="[150, 760]" width="560" height="72" color="0xFFFFFFFF" opacity="0.14" />
        <Label id="watchLabel" text="WATCH NOW" translation="[175, 760]" width="520" height="72" vertAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="31" />
        </Label>
        <Label id="nextLabel" text="NEXT EXHIBIT" translation="[175, 848]" width="520" height="72" vertAlign="center" color="0xB8B8B8FF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="31" />
        </Label>
        <Label id="hintLabel" translation="[174, 960]" width="1400" height="40" color="0x777777FF">
            <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="24" />
        </Label>

        <Timer id="countdownTimer" duration="1" repeat="true" />
    </children>
</component>
