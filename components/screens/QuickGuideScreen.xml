<?xml version="1.0" encoding="utf-8" ?>
<component name="QuickGuideScreen" extends="Group">
    <interface>
        <field id="exhibitId" type="string" onChange="configureGuide" />
        <field id="catalog" type="assocarray" onChange="configureGuide" />
        <field id="navEvent" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/catalogUtils.brs" />
    <script type="text/brightscript" uri="pkg:/components/screens/QuickGuideScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="guideVideo" width="1920" height="1080" visible="false" notificationInterval="0.25" />

        <Group id="placeholder">
            <Label
                text="QUICK GUIDE"
                translation="[200, 360]"
                width="1520"
                height="90"
                horizAlign="center"
                color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="64" />
            </Label>
            <Label
                text="The walkthrough is next."
                translation="[200, 470]"
                width="1520"
                height="60"
                horizAlign="center"
                color="0xA8A8A8FF">
                <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="30" />
            </Label>
            <Label
                text="BACK TO RETURN"
                translation="[200, 620]"
                width="1520"
                height="50"
                horizAlign="center"
                color="0x777777FF">
                <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="24" />
            </Label>
        </Group>

        <Group id="chrome" visible="false">
            <Rectangle translation="[0, 970]" width="1920" height="110" color="0x000000CC" />
            <Label id="guideStatus" translation="[70, 990]" width="1780" height="55" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/assets/fonts/ShareTechMono-Regular.ttf" size="25" />
            </Label>
        </Group>
    </children>
</component>
